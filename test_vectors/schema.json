{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuraShare test vectors",
  "type": "object",
  "required": ["version", "generated", "vectors"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Specification version targeted by this vector set."
    },
    "generated": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp for this vector set."
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
